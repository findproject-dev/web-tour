---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

export interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  transparentNavbar?: boolean;
}

const { 
  title = "FindPath — Temukan Sisi Liarmu di Kalimantan", 
  description = "Temukan pengalaman wisata Kalimantan yang terjangkau dan autentik. Jelajahi alam, budaya, dan petualangan di Borneo bersama FindPath.",
  ogImage = "/images/hero_klotok_river.jpg",
  transparentNavbar = false
} = Astro.props;
---

<!DOCTYPE html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    
    <title>{title}</title>
    <meta name="description" content={description} />
    
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={new URL(ogImage, Astro.site || Astro.url).toString()} />
    
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site || Astro.url).toString()} />
  </head>
  <body class="flex flex-col min-h-screen" data-transparent-navbar={transparentNavbar ? "true" : "false"}>
    <Navbar transparentNavbar={transparentNavbar} />
    <main class="flex-grow">
      <slot />
    </main>
    <Footer />
  </body>
</html>
