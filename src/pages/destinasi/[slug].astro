---
import Layout from '../../layouts/Layout.astro';
import { MapPin, Compass, Image as ImageIcon, ArrowLeft, ChevronRight, Star } from "lucide-astro";
import { destinations } from '../../data/destinations';
import { tours } from '../../data/tours';

export function getStaticPaths() {
  return destinations.map(dest => ({
    params: { slug: dest.slug },
    props: { dest },
  }));
}

const { dest } = Astro.props;

const relatedToursData = dest.relatedTours 
  ? tours.filter(t => dest.relatedTours.includes(t.slug))
  : [];
---

<Layout title={`${dest.name} — Wisata ${dest.province} | FindPath`} description={dest.shortDescription} ogImage={dest.heroImage} transparentNavbar={true}>
  
  <!-- Breadcrumb -->
  <div class="absolute top-24 left-0 w-full z-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 md:px-8 lg:px-10 xl:px-12">
      <nav class="flex text-sm text-white/80 font-medium">
        <a href="/" class="hover:text-white transition-colors">Beranda</a>
        <span class="mx-2">/</span>
        <a href="/destinasi" class="hover:text-white transition-colors">Destinasi</a>
        <span class="mx-2">/</span>
        <span class="text-white">{dest.name}</span>
      </nav>
    </div>
  </div>

  <!-- Hero Section -->
  <section class="relative h-[70vh] min-h-[480px] flex items-end pb-16 sm:pb-20 md:pb-24 overflow-hidden">
    <div class="absolute inset-0">
      <img src={dest.heroImage} alt={dest.name} class="w-full h-full object-cover" />
      <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/30 to-transparent"></div>
    </div>
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 md:px-8 lg:px-10 xl:px-12 w-full text-white">
      <div class="inline-flex items-center gap-2 px-3.5 sm:px-4 py-1.5 rounded-full bg-white/20 backdrop-blur-md border border-white/30 text-xs sm:text-sm font-semibold mb-4 sm:mb-6">
        <MapPin className="w-3.5 sm:w-4 h-3.5 sm:h-4" /> {dest.province}
      </div>
      <h1 class="font-display text-4xl sm:text-6xl md:text-7xl lg:text-8xl mb-4 sm:mb-6 tracking-tight leading-tight max-w-4xl drop-shadow-lg text-balance">
        {dest.name}
      </h1>
      <p class="text-base sm:text-xl md:text-2xl max-w-2xl text-gray-100 font-light drop-shadow-md text-balance">
        {dest.shortDescription}
      </p>
    </div>
  </section>

  <!-- Content Section -->
  <section class="py-12 sm:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 md:px-8 lg:px-10 xl:px-12">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-10 xl:gap-16">
        
        <!-- Main Content -->
        <div class="lg:col-span-2 space-y-16">
          
          <!-- About -->
          <div>
            <h2 class="font-display text-4xl text-primary mb-6">Tentang {dest.name}</h2>
            <div class="prose prose-lg prose-gray max-w-none leading-relaxed text-gray-700">
              <p>{dest.longDescription}</p>
            </div>
          </div>

          <!-- Experiences -->
          <div>
            <h2 class="font-display text-3xl text-primary mb-6">Pengalaman Tersedia</h2>
            <div class="flex flex-wrap gap-4">
              {dest.experienceTypes.map(exp => (
                <div class="px-6 py-3 bg-gray-50 border border-gray-100 rounded-xl flex items-center gap-3 text-gray-700 font-medium">
                  <Compass className="w-5 h-5 text-accent" />
                  <span class="capitalize">{exp.replace('-', ' ')}</span>
                </div>
              ))}
            </div>
          </div>

          <!-- Gallery (if any) -->
          {dest.gallery && dest.gallery.length > 0 && (
            <div>
              <h2 class="font-display text-3xl text-primary mb-6 flex items-center gap-3">
                <ImageIcon className="w-6 h-6 text-accent" /> Galeri Foto
              </h2>
              <div class="grid grid-cols-2 gap-4">
                {dest.gallery.map(img => (
                  <div class="aspect-square rounded-2xl overflow-hidden bg-gray-100">
                    <img src={img} alt="" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" loading="lazy" />
                  </div>
                ))}
              </div>
            </div>
          )}
          
        </div>

        <!-- Sidebar Info -->
        <div class="lg:col-span-1">
          <div class="sticky top-28 space-y-8">
            
            <div class="bg-bg p-8 rounded-3xl border border-gray-100">
              <h3 class="font-display text-2xl text-primary mb-6">Informasi Wisata</h3>
              
              <ul class="space-y-6">
                <li>
                  <span class="block text-sm text-gray-500 mb-1">Lokasi</span>
                  <span class="font-medium text-gray-900 flex items-start gap-2">
                    <MapPin className="w-5 h-5 text-accent shrink-0 mt-0.5" />
                    {dest.location}
                  </span>
                </li>
                <li>
                  <span class="block text-sm text-gray-500 mb-1">Durasi Ideal</span>
                  <span class="font-medium text-gray-900">{dest.recommendedDuration}</span>
                </li>
                {dest.bestTimeToVisit && (
                  <li>
                    <span class="block text-sm text-gray-500 mb-1">Waktu Terbaik</span>
                    <span class="font-medium text-gray-900">{dest.bestTimeToVisit}</span>
                  </li>
                )}
              </ul>

              <div class="mt-8 pt-8 border-t border-gray-200">
                {relatedToursData.length > 0 ? (
                  <a href="#related-tours" class="block w-full bg-primary hover:bg-secondary text-white text-center py-4 rounded-xl font-medium transition-colors">
                    Lihat Paket Tour
                  </a>
                ) : (
                  <a href="/paket-tour" class="block w-full bg-primary hover:bg-secondary text-white text-center py-4 rounded-xl font-medium transition-colors">
                    Lihat Semua Paket Tour
                  </a>
                )}
              </div>
            </div>



          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Related Tours -->
  {relatedToursData.length > 0 && (
    <section id="related-tours" class="py-16 sm:py-24 bg-bg border-t border-gray-200">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 md:px-8 lg:px-10 xl:px-12">
        <div class="mb-10 sm:mb-12">
          <h2 class="font-display text-3xl sm:text-4xl text-primary mb-3">Tour Terkait</h2>
          <p class="text-gray-600 text-base sm:text-lg">Jelajahi {dest.name} dengan paket pilihan kami.</p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
          {relatedToursData.map(tour => (
            <a href={`/paket-tour/${tour.slug}`} class="group bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-xl transition-shadow border border-gray-100 flex flex-col h-full">
              <div class="relative aspect-[4/3] overflow-hidden">
                <img src={tour.heroImage} alt={tour.name} class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" />
                <div class="absolute top-4 left-4 bg-white/90 backdrop-blur-sm px-3 py-1 rounded-full text-xs font-semibold text-primary">
                  {tour.duration}
                </div>
              </div>
              <div class="p-6 flex flex-col flex-grow">
                <div class="flex items-center justify-between mb-2">
                  <span class="text-xs font-medium text-gray-500 uppercase tracking-wider">{tour.type.replace('-', ' ')}</span>
                  <div class="flex items-center gap-1 text-highlight">
                    <Star className="w-3.5 h-3.5 fill-current" />
                    <span class="text-sm font-medium text-gray-700">{tour.rating}</span>
                  </div>
                </div>
                <h3 class="font-display text-2xl text-primary mb-2 line-clamp-1 group-hover:text-accent transition-colors">{tour.name}</h3>
                <p class="text-gray-600 text-sm mb-6 line-clamp-2 flex-grow">{tour.shortDescription}</p>
                <div class="border-t border-gray-100 pt-4 mt-auto">
                  <p class="text-sm text-gray-500 mb-1">Mulai dari</p>
                  <p class="text-lg font-bold text-primary">{tour.priceDisplay}<span class="text-sm font-normal text-gray-500"> /org</span></p>
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

</Layout>
