---
import Layout from '../../layouts/Layout.astro';
import { Search, MapPin, Compass, ChevronRight } from "lucide-astro";
import { destinations } from '../../data/destinations';

const provinces = ["Semua", "Kalimantan Barat", "Kalimantan Tengah", "Kalimantan Selatan", "Kalimantan Timur", "Kalimantan Utara"];
const experiences = ["Wildlife", "Beach", "Culture", "Adventure", "River", "Family"];
---

<Layout title="Destinasi Wisata Kalimantan — FindPath" description="Jelajahi 25 destinasi pilihan Kalimantan. Dari hutan hujan Tanjung Puting hingga Kepulauan Derawan.">
  <!-- Header -->
  <section class="pt-32 pb-14 sm:pb-16 bg-bg border-b border-gray-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 md:px-8 lg:px-10 xl:px-12">
      <h1 class="font-display text-4xl sm:text-5xl md:text-6xl text-primary mb-4 sm:mb-6">Eksplorasi Kalimantan</h1>
      <p class="text-lg sm:text-xl text-gray-600 max-w-2xl">Jelajahi keajaiban alam dan budaya dari 25 destinasi pilihan kami di Borneo.</p>
    </div>
  </section>

  <!-- Filter & Listing -->
  <section class="py-12 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 md:px-8 lg:px-10 xl:px-12">
      
      <div class="flex flex-col lg:flex-row gap-8 xl:gap-12">
        <!-- Sidebar Filters -->
        <aside class="w-full lg:w-64 xl:w-72 shrink-0">
          <div class="sticky top-28 space-y-8">
            <!-- Search -->
            <div>
              <div class="relative">
                <Search className="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 w-5 h-5" />
                <input type="text" id="search-input" aria-label="Cari destinasi" placeholder="Cari destinasi..." class="w-full pl-10 pr-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:ring-2 focus:ring-primary focus:border-transparent" />
              </div>
            </div>

            <!-- Province Filter -->
            <div>
              <h3 class="font-bold text-gray-900 mb-4 flex items-center gap-2">
                <MapPin className="w-5 h-5 text-accent" /> Provinsi
              </h3>
              <div class="space-y-2" id="province-filters">
                {provinces.map((prov, i) => (
                  <label class="flex items-center gap-3 cursor-pointer group">
                    <input type="radio" name="province" value={prov === "Semua" ? "all" : prov} checked={i === 0} class="w-5 h-5 text-primary border-gray-300 focus:ring-primary accent-primary" />
                    <span class="text-gray-700 group-hover:text-primary transition-colors">{prov}</span>
                  </label>
                ))}
              </div>
            </div>

            <!-- Experience Filter -->
            <div>
              <h3 class="font-bold text-gray-900 mb-4 flex items-center gap-2">
                <Compass className="w-5 h-5 text-accent" /> Pengalaman
              </h3>
              <div class="flex flex-wrap gap-2" id="exp-filters">
                {experiences.map(exp => (
                  <button type="button" data-exp={exp.toLowerCase()} class="exp-btn px-4 py-2 bg-gray-50 border border-gray-200 text-gray-700 text-sm rounded-full hover:bg-gray-100 transition-colors">
                    {exp}
                  </button>
                ))}
              </div>
            </div>

            <button id="clear-filters" class="w-full py-3 text-sm font-medium text-gray-500 hover:text-primary transition-colors">
              Reset Semua Filter
            </button>
          </div>
        </aside>

        <!-- Listing -->
        <div class="flex-1 min-w-0">
          <div class="flex justify-between items-center mb-8">
            <p class="text-gray-600 font-medium"><span id="result-count">{destinations.length}</span> destinasi ditemukan</p>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-6" id="destinations-grid">
            {destinations.map(dest => (
              <a href={`/destinasi/${dest.slug}`} class="dest-card group block bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 border border-gray-100" data-prov={dest.province} data-name={dest.name.toLowerCase()} data-exps={dest.category.join(',')}>
                <div class="relative aspect-[4/3] overflow-hidden">
                  <img src={dest.heroImage} alt={dest.name} class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" loading="lazy" />
                  <div class="absolute top-4 left-4 bg-white/90 backdrop-blur-sm px-3 py-1 rounded-full text-xs font-semibold text-primary">
                    {dest.province}
                  </div>
                </div>
                <div class="p-6">
                  <div class="flex flex-wrap gap-2 mb-3">
                    {dest.category.map(cat => (
                      <span class="text-[10px] uppercase tracking-wider font-bold text-accent">{cat}</span>
                    ))}
                  </div>
                  <h3 class="font-display text-2xl text-primary mb-2 group-hover:text-accent transition-colors">{dest.name}</h3>
                  <p class="text-gray-600 text-sm mb-6 line-clamp-2">{dest.shortDescription}</p>
                  
                  <div class="inline-flex items-center gap-2 text-primary text-sm font-medium">
                    Lihat Detail <ChevronRight className="w-4 h-4 transition-transform group-hover:translate-x-1" />
                  </div>
                </div>
              </a>
            ))}
          </div>

          <!-- Empty State -->
          <div id="empty-state" class="hidden text-center py-20">
            <MapPin className="w-16 h-16 text-gray-300 mx-auto mb-4" />
            <h3 class="font-display text-3xl text-primary mb-2">Destinasi Tidak Ditemukan</h3>
            <p class="text-gray-500">Coba ubah filter atau kata kunci pencarian Anda.</p>
            <button id="empty-reset" class="mt-6 bg-primary text-white px-6 py-2.5 rounded-full font-medium">Reset Filter</button>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- CTA -->
  <section class="py-24 bg-primary text-white text-center px-4">
    <h2 class="font-display text-4xl md:text-5xl mb-6">Sudah Menemukan Tujuanmu?</h2>
    <p class="text-xl text-gray-300 mb-10 max-w-2xl mx-auto">Lihat paket tour yang kami sediakan untuk destinasi pilihanmu.</p>
    <a href="/paket-tour" class="inline-block bg-white text-primary px-8 py-4 rounded-full font-medium transition-all transform hover:scale-105 active:scale-95 text-lg">
      Lihat Paket Tour
    </a>
  </section>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const searchInput = document.getElementById('search-input') as HTMLInputElement;
    const provRadios = document.querySelectorAll('input[name="province"]') as NodeListOf<HTMLInputElement>;
    const expBtns = document.querySelectorAll('.exp-btn');
    const cards = document.querySelectorAll('.dest-card') as NodeListOf<HTMLElement>;
    const resultCount = document.getElementById('result-count');
    const clearBtn = document.getElementById('clear-filters');
    const emptyState = document.getElementById('empty-state');
    const emptyReset = document.getElementById('empty-reset');
    const grid = document.getElementById('destinations-grid');

    let activeExps = new Set<string>();
    
    // Read URL params for initial state (e.g. from homepage)
    const urlParams = new URLSearchParams(window.location.search);
    const initialProv = urlParams.get('provinsi');
    if (initialProv) {
      provRadios.forEach(r => {
        if (r.value === initialProv) r.checked = true;
      });
    }

    function filterCards() {
      const searchVal = searchInput.value.toLowerCase();
      const provVal = Array.from(provRadios).find(r => r.checked)?.value || 'all';
      
      let count = 0;

      cards.forEach(card => {
        const name = card.dataset.name || '';
        const prov = card.dataset.prov || '';
        const exps = (card.dataset.exps || '').split(',');

        const matchSearch = name.includes(searchVal);
        const matchProv = provVal === 'all' || prov === provVal;
        
        let matchExp = true;
        if (activeExps.size > 0) {
          matchExp = Array.from(activeExps).some(actExp => exps.includes(actExp));
        }

        if (matchSearch && matchProv && matchExp) {
          card.style.display = 'block';
          count++;
        } else {
          card.style.display = 'none';
        }
      });

      if (resultCount) resultCount.textContent = count.toString();
      
      if (count === 0) {
        grid?.classList.add('hidden');
        emptyState?.classList.remove('hidden');
      } else {
        grid?.classList.remove('hidden');
        emptyState?.classList.add('hidden');
      }
    }

    searchInput?.addEventListener('input', filterCards);
    provRadios.forEach(r => r.addEventListener('change', filterCards));
    
    expBtns.forEach(btn => {
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLElement;
        const exp = target.dataset.exp || '';
        if (activeExps.has(exp)) {
          activeExps.delete(exp);
          target.classList.remove('bg-primary', 'text-white', 'border-primary');
          target.classList.add('bg-gray-50', 'text-gray-700', 'border-gray-200');
        } else {
          activeExps.add(exp);
          target.classList.remove('bg-gray-50', 'text-gray-700', 'border-gray-200');
          target.classList.add('bg-primary', 'text-white', 'border-primary');
        }
        filterCards();
      });
    });

    const resetAll = () => {
      searchInput.value = '';
      provRadios[0].checked = true; // Set "Semua"
      activeExps.clear();
      expBtns.forEach(btn => {
        btn.classList.remove('bg-primary', 'text-white', 'border-primary');
        btn.classList.add('bg-gray-50', 'text-gray-700', 'border-gray-200');
      });
      // Update URL without reloading
      window.history.replaceState({}, '', '/destinasi');
      filterCards();
    };

    clearBtn?.addEventListener('click', resetAll);
    emptyReset?.addEventListener('click', resetAll);

    // Initial filter run
    filterCards();
  });
</script>
