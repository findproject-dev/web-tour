 

---
import {
  ArrowRight,
  Calendar,
  ChevronRight,
  Compass,
  MapPin,
  Search,
  Star,
} from "lucide-astro";
import Layout from "../layouts/Layout.astro";
import { destinations } from "../data/destinations";
import { tours } from "../data/tours";

const featuredDestinations = [
  {
    province: "Kalimantan Tengah",
    slug: "Kalimantan Tengah",
    image: "/images/dest_kalteng.jpg",
    tagline: "Hutan hujan dan perjumpaan dengan orangutan.",
  },
  {
    province: "Kalimantan Timur",
    slug: "Kalimantan Timur",
    image: "/images/dest_kaltim.jpg",
    tagline: "Sungai Mahakam dan pesona kepulauan.",
  },
  {
    province: "Kalimantan Selatan",
    slug: "Kalimantan Selatan",
    image: "/images/dest_kalsel.jpg",
    tagline: "Pegunungan Meratus dan budaya sungai.",
  },
  {
    province: "Kalimantan Barat",
    slug: "Kalimantan Barat",
    image: "/images/dest_kalbar.jpg",
    tagline: "Kota khatulistiwa dan danau-danau luas.",
  },
  {
    province: "Kalimantan Utara",
    slug: "Kalimantan Utara",
    image: "/images/dest_kaltara.jpg",
    tagline: "Hutan tropis dan pesisir yang masih alami.",
  },
].map((destination) => ({
  ...destination,
  count: destinations.filter((item) => item.province === destination.province).length,
}));

const signatureExperiences = [
  {
    title: "Bertemu orangutan",
    subtitle: "Di jantung hutan Borneo",
    img: "/images/exp_orangutan.jpg",
    link: "/destinasi/tanjung-puting",
  },
  {
    title: "Menyusuri sungai",
    subtitle: "Ritme hidup di atas klotok",
    img: "/images/exp_river.jpg",
    link: "/paket-tour/river-culture-journey",
  },
  {
    title: "Menepi ke pulau",
    subtitle: "Laut biru Kalimantan",
    img: "/images/exp_island.jpg",
    link: "/destinasi/derawan-islands",
  },
  {
    title: "Menjelajah Meratus",
    subtitle: "Jalur hijau di pegunungan",
    img: "/images/exp_meratus.jpg",
    link: "/destinasi/loksado",
  },
];

const featuredTours = tours.filter((tour) => tour.featured).slice(0, 4);

const values = [
  {
    number: "01",
    title: "Kenal tempatnya, bukan cuma rutenya",
    body: "Kami tumbuh di Kalimantan dan membawa pengalaman langsung ke setiap perjalanan.",
  },
  {
    number: "02",
    title: "Berjalan bersama warga lokal",
    body: "Pemandu dan mitra lokal membuat perjalanan lebih bermakna sekaligus mendukung komunitas.",
  },
  {
    number: "03",
    title: "Perjalanan yang lebih bertanggung jawab",
    body: "Kami mengutamakan pengalaman yang menghormati alam, satwa, dan budaya setempat.",
  },
];

const testimonials = [
  {
    name: "Nadia Putri",
    origin: "Jakarta",
    quote: "Perjalanan klotoknya terasa personal. Pemandunya tahu banyak tentang hutan dan kehidupan di sungai.",
    rating: 5,
  },
  {
    name: "Rizky Mahendra",
    origin: "Bandung",
    quote: "Semua detail perjalanan ke Derawan terurus, dari penjemputan sampai island hopping.",
    rating: 5,
  },
  {
    name: "Maya Anindita",
    origin: "Surabaya",
    quote: "Loksado jadi pengalaman yang tidak akan terlupakan. Pemandu lokalnya ramah dan informatif.",
    rating: 5,
  },
];
---

<Layout title="FindPath — Temukan Sisi Liarmu di Kalimantan" transparentNavbar={true}>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "TravelAgency",
    "name": "FindPath",
    "url": "https://findpath.id",
    "description": "Temukan pengalaman wisata Kalimantan yang terjangkau dan autentik. Jelajahi alam, budaya, dan petualangan di Borneo bersama FindPath.",
    "image": "https://findpath.id/images/hero_klotok_river.jpg",
    "areaServed": {
      "@type": "State",
      "name": "Kalimantan",
      "containedInPlace": {
        "@type": "Country",
        "name": "Indonesia"
      }
    },
    "contactPoint": {
      "@type": "ContactPoint",
      "contactType": "customer service",
      "availableLanguage": ["Indonesian", "English"]
    }
  })} />
  <section class="relative flex min-h-[88svh] items-end overflow-hidden bg-primary">
    <img
      src="/images/hero_klotok_river.jpg"
      alt="Perahu klotok menyusuri sungai di tengah hutan Kalimantan"
      class="absolute inset-0 h-full w-full object-cover"
      fetchpriority="high"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-black/70 via-black/35 to-transparent"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-black/55 via-transparent to-black/20"></div>

    <!-- Content — bottom-left editorial positioning -->
    <div class="relative z-10 w-full pt-28 pb-14 sm:pb-16 md:pb-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 md:px-8 lg:px-10 xl:px-12">
        <div class="max-w-3xl">
          <!-- Location pill -->
          <div class="inline-flex items-center gap-2 mb-4 sm:mb-6 text-white/70 text-xs sm:text-sm font-medium tracking-wider uppercase">
            <span class="w-5 h-px bg-highlight inline-block"></span>
            <span>Kalimantan, Indonesia</span>
          </div>

          <!-- Headline -->
          <h1 class="font-display text-[clamp(2.5rem,5.5vw,5.5rem)] leading-[1.02] tracking-tight text-white mb-6 sm:mb-8 text-balance">
            Temukan<br/>
            <em class="text-highlight not-italic">Sisi Liarmu</em><br/>
            di Kalimantan
          </h1>

          <!-- Subheadline -->
          <p class="text-white/80 text-base sm:text-lg md:text-xl font-light max-w-xl leading-relaxed mb-8 sm:mb-10">
            Pengalaman Borneo yang sesungguhnya — hutan, sungai, pulau, dan budaya yang tak terlupakan.
          </p>

          <!-- CTAs -->
          <div class="flex flex-wrap gap-3 sm:gap-4">
            <a 
              href="/paket-tour" 
              class="group inline-flex items-center gap-2.5 bg-highlight hover:bg-highlight/90 text-primary px-6 sm:px-7 py-3 sm:py-3.5 rounded-full font-semibold transition-all text-sm sm:text-base shadow-lg shadow-black/20 hover:shadow-xl hover:scale-[1.02] active:scale-[0.98]"
            >
              Jelajahi Tour
              <ArrowRight className="w-4 h-4 transition-transform group-hover:translate-x-1" />
            </a>
            <a 
              href="/destinasi" 
              class="inline-flex items-center gap-2 backdrop-blur-sm bg-white/10 hover:bg-white/18 border border-white/30 text-white px-6 sm:px-7 py-3 sm:py-3.5 rounded-full font-medium transition-all text-sm sm:text-base"
            >
              Temukan Destinasi
            </a>
          </div>
        </div>

        <!-- Scroll indicator -->
        <div class="absolute bottom-8 right-8 hidden lg:flex flex-col items-center gap-2 text-white/40">
          <span class="text-xs uppercase tracking-widest rotate-90 origin-center mb-6 text-white/50">Scroll</span>
          <div class="w-px h-12 bg-gradient-to-b from-white/50 to-transparent animate-pulse"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================
       TRAVEL FINDER — clean strip below hero, responsive grid
       ========================================================= -->
  <section class="bg-white border-b border-gray-100 shadow-sm" aria-label="Cari tour">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 md:px-8 lg:px-10 xl:px-12 py-5 sm:py-6">
      <form action="/paket-tour" method="GET" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-12 gap-3 sm:gap-4 items-center">
        <div class="w-full sm:col-span-1 lg:col-span-4 relative">
          <label for="provinsi" class="sr-only">Pilih Provinsi</label>
          <MapPin className="absolute left-3.5 top-1/2 -translate-y-1/2 text-gray-400 w-4 h-4 pointer-events-none" />
          <select id="provinsi" name="provinsi" aria-label="Pilih Provinsi" class="w-full pl-10 pr-4 py-3 bg-gray-50 border border-gray-200 hover:border-gray-300 rounded-xl focus:ring-2 focus:ring-primary focus:border-transparent appearance-none text-sm font-medium text-gray-700 cursor-pointer transition-colors">
            <option value="">Semua Provinsi</option>
            <option value="Kalimantan Barat">Kalimantan Barat</option>
            <option value="Kalimantan Tengah">Kalimantan Tengah</option>
            <option value="Kalimantan Selatan">Kalimantan Selatan</option>
            <option value="Kalimantan Timur">Kalimantan Timur</option>
            <option value="Kalimantan Utara">Kalimantan Utara</option>
          </select>
        </div>
        <div class="w-full sm:col-span-1 lg:col-span-3 relative">
          <label for="tipe" class="sr-only">Jenis Tour</label>
          <Compass className="absolute left-3.5 top-1/2 -translate-y-1/2 text-gray-400 w-4 h-4 pointer-events-none" />
          <select id="tipe" name="tipe" aria-label="Jenis Tour" class="w-full pl-10 pr-4 py-3 bg-gray-50 border border-gray-200 hover:border-gray-300 rounded-xl focus:ring-2 focus:ring-primary focus:border-transparent appearance-none text-sm font-medium text-gray-700 cursor-pointer transition-colors">
            <option value="">Semua Jenis Tour</option>
            <option value="multi-day">Multi-Day</option>
            <option value="day-trip">Day Trip</option>
            <option value="private">Private Tour</option>
          </select>
        </div>
        <div class="w-full sm:col-span-1 lg:col-span-3 relative">
          <label for="tanggal" class="sr-only">Tanggal Keberangkatan</label>
          <Calendar className="absolute left-3.5 top-1/2 -translate-y-1/2 text-gray-400 w-4 h-4 pointer-events-none" />
          <input id="tanggal" type="date" name="tanggal" aria-label="Tanggal Keberangkatan" class="w-full pl-10 pr-4 py-3 bg-gray-50 border border-gray-200 hover:border-gray-300 rounded-xl focus:ring-2 focus:ring-primary focus:border-transparent text-sm font-medium text-gray-600 transition-colors" />
        </div>
        <div class="w-full sm:col-span-1 lg:col-span-2">
          <button type="submit" class="w-full bg-primary hover:bg-secondary text-white py-3 px-6 rounded-xl font-semibold transition-all flex items-center justify-center gap-2 text-sm shadow-md shadow-primary/20 whitespace-nowrap hover:scale-[1.02] active:scale-[0.98] focus:ring-2 focus:ring-offset-2 focus:ring-primary">
            <Search className="w-4 h-4" />
            Cari Tour
          </button>
        </div>
      </form>
    </div>
  </section>

  <!-- =========================================================
       FEATURED DESTINATIONS — editorial bento composition
       ========================================================= -->
  <section class="py-16 md:py-24 lg:py-28 bg-bg" aria-labelledby="destinations-heading">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 md:px-8 lg:px-10 xl:px-12">
      
      <!-- Section header -->
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-10 md:mb-12">
        <div>
          <p class="text-xs font-semibold uppercase tracking-widest text-accent mb-2.5">5 Provinsi · 25+ Destinasi</p>
          <h2 id="destinations-heading" class="font-display text-4xl md:text-5xl lg:text-6xl text-primary leading-tight">
            Jelajahi<br class="hidden sm:block"/> Kalimantan
          </h2>
        </div>
        <a href="/destinasi" class="inline-flex items-center gap-2 text-sm font-semibold text-primary hover:text-accent transition-colors group self-start md:self-auto pb-1 border-b-2 border-primary/30 hover:border-accent">
          Semua Destinasi <ChevronRight className="w-4 h-4 transition-transform group-hover:translate-x-0.5" />
        </a>
      </div>

      <!-- Bento grid for Desktop (lg+) -->
      <div class="hidden lg:grid grid-cols-12 grid-rows-2 gap-4 xl:gap-5 min-h-[560px] xl:h-[600px]">
        
        <!-- Large card: Kalteng (col 1-5, rows 1-2) -->
        <a href={`/destinasi?provinsi=${featuredDestinations[0].slug}`} 
           class="col-span-5 row-span-2 group relative rounded-2xl overflow-hidden"
           aria-label={`Jelajahi ${featuredDestinations[0].province}`}>
          <img src={featuredDestinations[0].image} alt={featuredDestinations[0].province} class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" loading="lazy" />
          <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/25 to-transparent"></div>
          <div class="absolute inset-x-0 bottom-0 p-6 xl:p-8">
            <span class="text-highlight text-xs font-bold uppercase tracking-widest mb-2.5 block">{featuredDestinations[0].count} Destinasi</span>
            <h3 class="font-display text-3xl xl:text-4xl text-white mb-2.5 leading-tight">{featuredDestinations[0].province}</h3>
            <p class="text-white/70 text-sm mb-5 leading-relaxed line-clamp-2">{featuredDestinations[0].tagline}</p>
            <span class="inline-flex items-center gap-2 text-white text-sm font-semibold border-b border-white/40 pb-0.5 group-hover:border-white transition-colors">
              Jelajahi <ArrowRight className="w-3.5 h-3.5 transition-transform group-hover:translate-x-1" />
            </span>
          </div>
        </a>

        <!-- Top right: Kaltim -->
        <a href={`/destinasi?provinsi=${featuredDestinations[1].slug}`}
           class="col-span-4 row-span-1 group relative rounded-2xl overflow-hidden"
           aria-label={`Jelajahi ${featuredDestinations[1].province}`}>
          <img src={featuredDestinations[1].image} alt={featuredDestinations[1].province} class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" loading="lazy" />
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/15 to-transparent"></div>
          <div class="absolute bottom-0 left-0 p-5 xl:p-6">
            <span class="text-highlight text-xs font-bold uppercase tracking-wider mb-1 block">{featuredDestinations[1].count} Destinasi</span>
            <h3 class="font-display text-2xl xl:text-3xl text-white leading-tight">{featuredDestinations[1].province}</h3>
          </div>
          <div class="absolute top-4 right-4 opacity-0 group-hover:opacity-100 transition-opacity">
            <span class="bg-white/20 backdrop-blur-sm text-white text-xs font-medium px-3 py-1 rounded-full border border-white/30">Jelajahi →</span>
          </div>
        </a>

        <!-- Top far right: Kalsel -->
        <a href={`/destinasi?provinsi=${featuredDestinations[2].slug}`}
           class="col-span-3 row-span-1 group relative rounded-2xl overflow-hidden"
           aria-label={`Jelajahi ${featuredDestinations[2].province}`}>
          <img src={featuredDestinations[2].image} alt={featuredDestinations[2].province} class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" loading="lazy" />
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/15 to-transparent"></div>
          <div class="absolute bottom-0 left-0 p-5 xl:p-6">
            <span class="text-highlight text-xs font-bold uppercase tracking-wider mb-1 block">{featuredDestinations[2].count} Destinasi</span>
            <h3 class="font-display text-xl xl:text-2xl text-white leading-tight">{featuredDestinations[2].province.replace('Kalimantan ', 'Kal.')}</h3>
          </div>
          <div class="absolute top-4 right-4 opacity-0 group-hover:opacity-100 transition-opacity">
            <span class="bg-white/20 backdrop-blur-sm text-white text-xs font-medium px-3 py-1 rounded-full border border-white/30">Jelajahi →</span>
          </div>
        </a>

        <!-- Bottom right: Kalbar -->
        <a href={`/destinasi?provinsi=${featuredDestinations[3].slug}`}
           class="col-span-3 row-span-1 group relative rounded-2xl overflow-hidden"
           aria-label={`Jelajahi ${featuredDestinations[3].province}`}>
          <img src={featuredDestinations[3].image} alt={featuredDestinations[3].province} class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" loading="lazy" />
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/15 to-transparent"></div>
          <div class="absolute bottom-0 left-0 p-5 xl:p-6">
            <span class="text-highlight text-xs font-bold uppercase tracking-wider mb-1 block">{featuredDestinations[3].count} Destinasi</span>
            <h3 class="font-display text-xl xl:text-2xl text-white leading-tight">{featuredDestinations[3].province.replace('Kalimantan ', 'Kal.')}</h3>
          </div>
          <div class="absolute top-4 right-4 opacity-0 group-hover:opacity-100 transition-opacity">
            <span class="bg-white/20 backdrop-blur-sm text-white text-xs font-medium px-3 py-1 rounded-full border border-white/30">Jelajahi →</span>
          </div>
        </a>

        <!-- Bottom far right: Kaltara -->
        <a href={`/destinasi?provinsi=${featuredDestinations[4].slug}`}
           class="col-span-4 row-span-1 group relative rounded-2xl overflow-hidden"
           aria-label={`Jelajahi ${featuredDestinations[4].province}`}>
          <img src={featuredDestinations[4].image} alt={featuredDestinations[4].province} class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" loading="lazy" />
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/15 to-transparent"></div>
          <div class="absolute bottom-0 left-0 p-5 xl:p-6">
            <span class="text-highlight text-xs font-bold uppercase tracking-wider mb-1 block">{featuredDestinations[4].count} Destinasi</span>
            <h3 class="font-display text-2xl xl:text-3xl text-white leading-tight">{featuredDestinations[4].province}</h3>
          </div>
          <div class="absolute top-4 right-4 opacity-0 group-hover:opacity-100 transition-opacity">
            <span class="bg-white/20 backdrop-blur-sm text-white text-xs font-medium px-3 py-1 rounded-full border border-white/30">Jelajahi →</span>
          </div>
        </a>
      </div>

      <!-- Tablet grid (sm to lg) -->
      <div class="hidden sm:grid lg:hidden grid-cols-2 md:grid-cols-3 gap-4">
        {featuredDestinations.map((dest, i) => (
          <a href={`/destinasi?provinsi=${dest.slug}`}
             class={`group relative rounded-2xl overflow-hidden ${i === 0 ? 'col-span-2 aspect-[21/9]' : 'aspect-[4/3]'}`}
             aria-label={`Jelajahi ${dest.province}`}>
            <img src={dest.image} alt={dest.province} class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" loading="lazy" />
            <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/20 to-transparent"></div>
            <div class="absolute bottom-0 left-0 p-5">
              <span class="text-highlight text-xs font-bold uppercase tracking-wider mb-1 block">{dest.count} Destinasi</span>
              <h3 class="font-display text-2xl text-white mb-1 leading-tight">{dest.province}</h3>
              <p class="text-white/70 text-xs leading-snug line-clamp-1">{dest.tagline}</p>
            </div>
          </a>
        ))}
      </div>

      <!-- Mobile: horizontal scroll -->
      <div class="sm:hidden flex gap-4 overflow-x-auto pb-6 hide-scrollbar snap-x snap-mandatory -mx-4 px-4">
        {featuredDestinations.map(dest => (
          <a href={`/destinasi?provinsi=${dest.slug}`}
             class="snap-start shrink-0 w-64 group relative rounded-2xl overflow-hidden aspect-[3/4]"
             aria-label={`Jelajahi ${dest.province}`}>
            <img src={dest.image} alt={dest.province} class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" loading="lazy" />
            <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/20 to-transparent"></div>
            <div class="absolute bottom-0 left-0 p-5">
              <span class="text-highlight text-xs font-bold uppercase tracking-wider mb-1.5 block">{dest.count} Destinasi</span>
              <h3 class="font-display text-2xl text-white mb-1">{dest.province}</h3>
              <p class="text-white/70 text-xs leading-snug">{dest.tagline}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- =========================================================
       SIGNATURE EXPERIENCES — responsive editorial grid
       ========================================================= -->
  <section class="py-16 md:py-24 lg:py-28 bg-primary" aria-labelledby="experiences-heading">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 md:px-8 lg:px-10 xl:px-12">
      
      <!-- Header -->
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-10 md:mb-12">
        <div class="max-w-xl">
          <p class="text-highlight text-xs font-semibold uppercase tracking-widest mb-2.5">Pengalaman Khas</p>
          <h2 id="experiences-heading" class="font-display text-4xl md:text-5xl lg:text-6xl text-white leading-tight text-balance">
            Yang tak bisa<br/>kamu temukan<br/>di tempat lain.
          </h2>
        </div>
        <p class="text-white/60 text-sm sm:text-base max-w-xs leading-relaxed md:text-right">
          Empat pengalaman yang mendefinisikan apa artinya benar-benar menjelajahi Kalimantan.
        </p>
      </div>

      <!-- Desktop layout (lg+) -->
      <div class="hidden lg:grid grid-cols-12 gap-5 h-[400px] xl:h-[440px]">
        <!-- Wide left: Orangutan -->
        <a href={signatureExperiences[0].link} aria-label={signatureExperiences[0].title} class="block col-span-7 group relative rounded-2xl overflow-hidden cursor-pointer focus:outline-none focus:ring-4 focus:ring-accent focus:ring-offset-2 focus:ring-offset-primary transition-shadow">
          <img src={signatureExperiences[0].img} alt={signatureExperiences[0].title} class="w-full h-full object-cover opacity-85 transition-transform duration-700 group-hover:scale-[1.03]" loading="lazy" />
          <div class="absolute inset-0 bg-gradient-to-t from-black/75 via-black/10 to-transparent transition-opacity group-hover:opacity-90"></div>
          <div class="absolute bottom-6 xl:bottom-8 left-6 xl:left-8 right-6 xl:right-8">
            <p class="text-highlight text-xs font-semibold uppercase tracking-widest mb-1.5">{signatureExperiences[0].subtitle}</p>
            <h3 class="font-display text-3xl xl:text-4xl text-white group-hover:text-highlight transition-colors">{signatureExperiences[0].title}</h3>
          </div>
        </a>

        <!-- Narrow right: Sungai -->
        <a href={signatureExperiences[1].link} aria-label={signatureExperiences[1].title} class="block col-span-5 group relative rounded-2xl overflow-hidden cursor-pointer focus:outline-none focus:ring-4 focus:ring-accent focus:ring-offset-2 focus:ring-offset-primary transition-shadow">
          <img src={signatureExperiences[1].img} alt={signatureExperiences[1].title} class="w-full h-full object-cover opacity-85 transition-transform duration-700 group-hover:scale-[1.03]" loading="lazy" />
          <div class="absolute inset-0 bg-gradient-to-t from-black/75 via-black/10 to-transparent transition-opacity group-hover:opacity-90"></div>
          <div class="absolute bottom-6 xl:bottom-8 left-6 xl:left-8 right-6 xl:right-8">
            <p class="text-highlight text-xs font-semibold uppercase tracking-widest mb-1.5">{signatureExperiences[1].subtitle}</p>
            <h3 class="font-display text-2xl xl:text-3xl text-white group-hover:text-highlight transition-colors">{signatureExperiences[1].title}</h3>
          </div>
        </a>
      </div>

      <div class="hidden lg:grid grid-cols-12 gap-5 h-[280px] xl:h-[320px] mt-5">
        <!-- Narrow left: Kepulauan -->
        <a href={signatureExperiences[2].link} aria-label={signatureExperiences[2].title} class="block col-span-5 group relative rounded-2xl overflow-hidden cursor-pointer focus:outline-none focus:ring-4 focus:ring-accent focus:ring-offset-2 focus:ring-offset-primary transition-shadow">
          <img src={signatureExperiences[2].img} alt={signatureExperiences[2].title} class="w-full h-full object-cover opacity-85 transition-transform duration-700 group-hover:scale-[1.03]" loading="lazy" />
          <div class="absolute inset-0 bg-gradient-to-t from-black/75 via-black/10 to-transparent transition-opacity group-hover:opacity-90"></div>
          <div class="absolute bottom-6 left-6 right-6">
            <p class="text-highlight text-xs font-semibold uppercase tracking-widest mb-1.5">{signatureExperiences[2].subtitle}</p>
            <h3 class="font-display text-2xl xl:text-3xl text-white group-hover:text-highlight transition-colors">{signatureExperiences[2].title}</h3>
          </div>
        </a>

        <!-- Wide right: Meratus -->
        <a href={signatureExperiences[3].link} aria-label={signatureExperiences[3].title} class="block col-span-7 group relative rounded-2xl overflow-hidden cursor-pointer focus:outline-none focus:ring-4 focus:ring-accent focus:ring-offset-2 focus:ring-offset-primary transition-shadow">
          <img src={signatureExperiences[3].img} alt={signatureExperiences[3].title} class="w-full h-full object-cover opacity-85 transition-transform duration-700 group-hover:scale-[1.03]" loading="lazy" />
          <div class="absolute inset-0 bg-gradient-to-t from-black/75 via-black/10 to-transparent transition-opacity group-hover:opacity-90"></div>
          <div class="absolute bottom-6 left-6 right-6">
            <p class="text-highlight text-xs font-semibold uppercase tracking-widest mb-1.5">{signatureExperiences[3].subtitle}</p>
            <h3 class="font-display text-3xl xl:text-4xl text-white group-hover:text-highlight transition-colors">{signatureExperiences[3].title}</h3>
          </div>
        </a>
      </div>

      <!-- Tablet & Mobile layout (< lg) -->
      <div class="lg:hidden grid grid-cols-1 sm:grid-cols-2 gap-4">
        {signatureExperiences.map(exp => (
          <a href={exp.link} aria-label={exp.title} class="block group relative rounded-2xl overflow-hidden aspect-[16/10] sm:aspect-[4/3] focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-primary transition-shadow">
            <img src={exp.img} alt={exp.title} class="w-full h-full object-cover opacity-85 transition-transform duration-700 group-hover:scale-105" loading="lazy" />
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent transition-opacity group-hover:opacity-90"></div>
            <div class="absolute bottom-4 sm:bottom-5 left-4 sm:left-5 right-4 sm:right-5">
              <p class="text-highlight text-xs font-semibold uppercase tracking-wider mb-1">{exp.subtitle}</p>
              <h3 class="font-display text-xl sm:text-2xl text-white leading-tight group-hover:text-highlight transition-colors">{exp.title}</h3>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- =========================================================
       FEATURED TOURS — clean cards, spacious grid
       ========================================================= -->
  <section class="py-16 md:py-24 lg:py-28 bg-bg" aria-labelledby="tours-heading">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 md:px-8 lg:px-10 xl:px-12">
      
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-10 md:mb-12">
        <div>
          <p class="text-xs font-semibold uppercase tracking-widest text-accent mb-2.5">Paket Terpilih</p>
          <h2 id="tours-heading" class="font-display text-4xl md:text-5xl text-primary">Mulai dari Sini</h2>
        </div>
        <a href="/paket-tour" class="inline-flex items-center gap-2 text-sm font-semibold text-primary hover:text-accent transition-colors group self-start md:self-auto pb-1 border-b-2 border-primary/30 hover:border-accent">
          Semua Paket Tour <ChevronRight className="w-4 h-4 transition-transform group-hover:translate-x-0.5" />
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6 xl:gap-8">
        {featuredTours.map((tour, i) => (
          <a 
            href={`/paket-tour/${tour.slug}`} 
            class="group bg-white rounded-2xl overflow-hidden border border-gray-100 hover:border-transparent hover:shadow-[0_12px_40px_rgba(26,54,38,0.12)] transition-all duration-300 flex flex-col"
            aria-label={`${tour.name} — ${tour.duration} mulai ${tour.priceDisplay}`}
          >
            <!-- Image -->
            <div class="relative aspect-[3/2] overflow-hidden">
              <img src={tour.heroImage} alt={tour.name} class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" loading="lazy" />
              <!-- Type badge -->
              <div class="absolute top-3 left-3 bg-white/90 backdrop-blur-sm px-2.5 py-1 rounded-full">
                <span class="text-xs font-bold text-primary uppercase tracking-wider">{tour.duration}</span>
              </div>
              <!-- Availability badge -->
              {tour.availabilityStatus === 'limited' && (
                <div class="absolute top-3 right-3 bg-orange-500/90 backdrop-blur-sm px-2.5 py-1 rounded-full">
                  <span class="text-xs font-bold text-white uppercase tracking-wider">Terbatas</span>
                </div>
              )}
            </div>

            <!-- Content -->
            <div class="p-5 flex flex-col flex-grow">
              <!-- Province + Rating -->
              <div class="flex items-center justify-between mb-2">
                <span class="text-xs font-bold text-gray-400 uppercase tracking-wider">{tour.province.replace('Kalimantan ', 'Kal. ')}</span>
                <div class="flex items-center gap-1">
                  <Star className="w-3 h-3 fill-highlight text-highlight" />
                  <span class="text-xs font-semibold text-gray-600">{tour.rating}</span>
                </div>
              </div>

              <!-- Name -->
              <h3 class="font-display text-xl text-primary mb-2 leading-tight group-hover:text-accent transition-colors line-clamp-2">{tour.name}</h3>
              
              <!-- Description -->
              <p class="text-gray-500 text-xs leading-relaxed mb-4 line-clamp-2 flex-grow">{tour.shortDescription}</p>

              <!-- Tags -->
              <div class="flex flex-wrap gap-1.5 mb-4">
                {tour.highlights.slice(0, 2).map(h => (
                  <span class="bg-gray-50 border border-gray-100 text-gray-500 text-xs px-2 py-0.5 rounded-md font-medium">{h}</span>
                ))}
              </div>

              <!-- Price + CTA -->
              <div class="border-t border-gray-50 pt-4 flex items-end justify-between">
                <div>
                  <p class="text-xs text-gray-400 mb-0.5 font-medium">Mulai dari</p>
                  <p class="text-base font-bold text-primary">{tour.priceDisplay} <span class="text-xs font-normal text-gray-400">/org</span></p>
                </div>
                <div class="w-8 h-8 rounded-full bg-gray-50 group-hover:bg-primary flex items-center justify-center transition-colors">
                  <ArrowRight className="w-3.5 h-3.5 text-gray-400 group-hover:text-white transition-colors" />
                </div>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- =========================================================
       WHY TRAVEL WITH US — numbered editorial, not generic icons
       ========================================================= -->
  <section class="py-16 md:py-24 lg:py-28 bg-white" aria-labelledby="why-heading">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 md:px-8 lg:px-10 xl:px-12">
      
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 xl:gap-24 items-start">
        <!-- Left: heading + image -->
        <div class="relative">
          <p class="text-xs font-semibold uppercase tracking-widest text-accent mb-3 sm:mb-4">Mengapa FindPath</p>
          <h2 id="why-heading" class="font-display text-4xl md:text-5xl lg:text-6xl text-primary mb-8 sm:mb-10 leading-tight text-balance">
            Kami tahu<br/>Kalimantan<br/>lebih dalam.
          </h2>
          
          <!-- Quote mark image composition -->
          <div class="relative rounded-2xl overflow-hidden aspect-[4/3]">
            <img 
              src="/images/why_guide.jpg" 
              alt="Panduan lokal Dayak bersama wisatawan di hutan Kalimantan" 
              class="w-full h-full object-cover"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-primary/60 to-transparent"></div>
            <div class="absolute bottom-6 left-6 right-6">
              <p class="font-display text-2xl text-white italic leading-snug">
                "Kami bukan agen perjalanan biasa — kami adalah orang Kalimantan."
              </p>
            </div>
          </div>
        </div>

        <!-- Right: numbered values -->
        <div class="space-y-0 divide-y divide-gray-100">
          {values.map((v, i) => (
            <div class="py-6 sm:py-8 group cursor-default">
              <div class="flex items-start gap-5 sm:gap-6">
                <span class="font-display text-3xl sm:text-4xl text-gray-200 group-hover:text-highlight transition-colors duration-300 leading-none pt-0.5 select-none">{v.number}</span>
                <div>
                  <h3 class="font-display text-xl sm:text-2xl text-primary mb-2 group-hover:text-accent transition-colors">{v.title}</h3>
                  <p class="text-gray-500 leading-relaxed text-sm">{v.body}</p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================
       BRAND STORY — emotional pause, full-bleed image
       ========================================================= -->
  <section class="relative py-24 sm:py-32 md:py-40 overflow-hidden" aria-label="Tentang FindPath">
    <div class="absolute inset-0">
      <img 
        src="/images/brand_story.jpg" 
        alt="Pagi di atas sungai Kalimantan — kabut tipis dan keheningan alam" 
        class="w-full h-full object-cover"
        loading="lazy"
      />
      <!-- Cinematic color grading overlay -->
      <div class="absolute inset-0 bg-primary/75 mix-blend-multiply"></div>
      <div class="absolute inset-0 bg-gradient-to-t from-primary/80 via-transparent to-primary/40"></div>
    </div>

    <div class="relative z-10 max-w-3xl mx-auto px-5 sm:px-8 text-center text-white">
      <!-- Decorative rule -->
      <div class="flex items-center justify-center gap-4 mb-8 sm:mb-10">
        <div class="h-px w-12 bg-highlight/60"></div>
        <span class="text-highlight text-xs font-semibold uppercase tracking-widest">Tentang Kalimantan</span>
        <div class="h-px w-12 bg-highlight/60"></div>
      </div>

      <blockquote class="font-display text-3xl sm:text-4xl md:text-5xl lg:text-6xl leading-tight text-white mb-8 sm:mb-10 text-balance">
        "Kalimantan bukan sekadar destinasi.<br/>
        <em>Kalimantan adalah sebuah perasaan.</em>"
      </blockquote>

      <p class="text-white/70 text-base sm:text-lg font-light leading-relaxed max-w-xl mx-auto">
        Pagi di atas klotok, kabut tipis di atas sungai, suara hutan yang belum pernah kamu dengar. Pulang dengan cerita, bukan sekadar foto.
      </p>

      <div class="mt-8 sm:mt-10">
        <a href="/tentang-kami" class="inline-flex items-center gap-2 text-white/80 hover:text-white text-sm font-medium border-b border-white/30 hover:border-white pb-0.5 transition-colors">
          Cerita kami <ArrowRight className="w-3.5 h-3.5" />
        </a>
      </div>
    </div>
  </section>

  <!-- =========================================================
       TESTIMONIALS — clean editorial, no SaaS carousel feel
       ========================================================= -->
  <section class="py-16 md:py-24 lg:py-28 bg-bg" aria-labelledby="testimonials-heading">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 md:px-8 lg:px-10 xl:px-12">
      
      <div class="mb-10 md:mb-14">
        <p class="text-xs font-semibold uppercase tracking-widest text-accent mb-2.5">Kata Mereka</p>
        <h2 id="testimonials-heading" class="font-display text-4xl md:text-5xl text-primary">Sudah Pernah Menjelajah</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 xl:gap-8">
        {testimonials.map((testi, i) => (
          <div class={`bg-white p-6 sm:p-8 rounded-2xl border ${i === 1 ? 'border-primary/20 shadow-[0_8px_30px_rgba(26,54,38,0.08)]' : 'border-gray-100'} flex flex-col`}>
            <!-- Stars -->
            <div class="flex gap-1 mb-5 sm:mb-6">
              {[...Array(testi.rating)].map(() => (
                <Star className="w-4 h-4 fill-highlight text-highlight" />
              ))}
            </div>

            <!-- Quote -->
            <blockquote class="text-gray-700 text-sm leading-relaxed flex-grow mb-6 sm:mb-8">
              "{testi.quote}"
            </blockquote>
            
            <!-- Identity -->
            <div class="flex items-center gap-4 pt-5 sm:pt-6 border-t border-gray-50">
              <!-- Avatar: initials with brand color -->
              <div class="w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center shrink-0">
                <span class="font-display text-primary font-bold text-base">{testi.name.charAt(0)}</span>
              </div>
              <div>
                <p class="font-semibold text-gray-900 text-sm">{testi.name}</p>
                <p class="text-gray-400 text-xs">{testi.origin}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- =========================================================
       FINAL CTA — image-led closing invitation
       ========================================================= -->
  <section class="relative overflow-hidden" aria-label="Mulai perjalananmu">
    <!-- Full-bleed image background -->
    <div class="absolute inset-0">
      <img 
        src="/images/cta_bg.jpg" 
        alt="Pantai tropis Kalimantan dari udara" 
        class="w-full h-full object-cover"
        loading="lazy"
      />
      <div class="absolute inset-0 bg-primary/80 mix-blend-multiply"></div>
      <div class="absolute inset-0 bg-gradient-to-br from-primary/70 via-primary/60 to-accent/50"></div>
    </div>

    <div class="relative z-10 py-24 sm:py-32 md:py-40 text-center text-white px-5 sm:px-8">
      <div class="max-w-3xl mx-auto">
        <p class="text-highlight text-xs font-semibold uppercase tracking-widest mb-4 sm:mb-6">Mulai Sekarang</p>
        <h2 class="font-display text-4xl sm:text-5xl md:text-6xl lg:text-7xl mb-6 sm:mb-8 leading-tight text-balance">
          Siap Menemukan<br/>
          <em>Sisi Liarmu?</em>
        </h2>
        <p class="text-white/75 text-base sm:text-lg md:text-xl font-light mb-10 sm:mb-12 max-w-xl mx-auto leading-relaxed text-balance">
          Pilih paket yang ada, atau ceritakan impian perjalananmu dan biarkan kami merancangnya.
        </p>
        <div class="flex flex-col sm:flex-row gap-3.5 sm:gap-4 justify-center">
          <a 
            href="/booking" 
            class="group inline-flex items-center justify-center gap-2.5 bg-highlight hover:bg-highlight/90 text-primary px-8 py-3.5 sm:py-4 rounded-full font-semibold transition-all text-base shadow-lg shadow-black/20 hover:scale-[1.02] active:scale-[0.98]"
          >
            Pesan Sekarang
            <ArrowRight className="w-4 h-4 transition-transform group-hover:translate-x-1" />
          </a>
          <a 
            href="/kontak" 
            class="inline-flex items-center justify-center gap-2 backdrop-blur-sm bg-white/10 hover:bg-white/18 border border-white/30 text-white px-8 py-3.5 sm:py-4 rounded-full font-medium transition-all text-base"
          >
            Hubungi Kami
          </a>
        </div>
      </div>
    </div>
  </section>

</Layout>
