---
import Layout from '../../layouts/Layout.astro';
import { tours } from '../../data/tours';
import { MapPin, Clock, Star, CheckCircle2, XCircle, Image as ImageIcon, ChevronRight } from "lucide-astro";

export function getStaticPaths() {
  return tours.map(tour => ({
    params: { slug: tour.slug },
    props: { tour },
  }));
}

const { tour } = Astro.props;

const relatedToursData = tour.relatedTours 
  ? tours.filter(t => tour.relatedTours.includes(t.slug))
  : [];
---

<Layout title={`${tour.name} — ${tour.duration} | FindPath`} description={tour.shortDescription} ogImage={tour.heroImage} transparentNavbar={true}>
  
  <!-- Breadcrumb -->
  <div class="absolute top-24 left-0 w-full z-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 md:px-8 lg:px-10 xl:px-12">
      <nav class="flex text-sm text-white/80 font-medium overflow-x-auto hide-scrollbar whitespace-nowrap">
        <a href="/" class="hover:text-white transition-colors">Beranda</a>
        <span class="mx-2">/</span>
        <a href="/paket-tour" class="hover:text-white transition-colors">Paket Tour</a>
        <span class="mx-2">/</span>
        <span class="text-white">{tour.name}</span>
      </nav>
    </div>
  </div>

  <!-- Hero -->
  <section class="relative h-[80vh] min-h-[560px] flex items-end pb-16 md:pb-24 overflow-hidden">
    <div class="absolute inset-0">
      <img src={tour.heroImage} alt={tour.name} class="w-full h-full object-cover" />
      <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-transparent"></div>
    </div>
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 md:px-8 lg:px-10 xl:px-12 w-full text-white">
      
      <div class="flex flex-wrap gap-3 mb-6">
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-white/20 backdrop-blur-md border border-white/30 text-xs font-semibold uppercase tracking-wider">
          {tour.type.replace('-', ' ')}
        </div>
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-white/20 backdrop-blur-md border border-white/30 text-xs font-semibold">
          <MapPin className="w-3.5 h-3.5" /> {tour.destination}
        </div>
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-white/20 backdrop-blur-md border border-white/30 text-xs font-semibold">
          <Clock className="w-3.5 h-3.5" /> {tour.duration}
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 lg:gap-12 items-end">
        <div class="lg:col-span-2">
          <h1 class="font-display text-4xl md:text-6xl lg:text-7xl mb-4 tracking-tight leading-tight drop-shadow-lg text-balance">
            {tour.name}
          </h1>
          <div class="flex flex-wrap items-center gap-4 text-gray-200 text-sm md:text-base">
            <div class="flex items-center gap-1 text-highlight">
              <Star className="w-5 h-5 fill-current" />
              <span class="text-white font-bold">{tour.rating}</span>
            </div>
            <span class="text-white/60">|</span>
            <span>{tour.reviewCount} Reviews</span>
            <span class="text-white/60">|</span>
            <span class="capitalize">{tour.province}</span>
          </div>
        </div>
        
        <div class="lg:col-span-1 lg:text-right hidden md:block">
          <p class="text-white/80 text-sm mb-1">Mulai dari</p>
          <p class="text-4xl font-bold text-white mb-6">{tour.priceDisplay}<span class="text-lg font-normal text-white/70"> {tour.priceUnit.replace('per', '/')}</span></p>
          <a href={`/booking?tour=${tour.slug}`} class="inline-block bg-primary hover:bg-secondary text-white px-8 py-4 rounded-full font-medium transition-all text-lg shadow-lg hover:shadow-xl w-full text-center">
            Pesan Sekarang
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Mobile sticky CTA (bottom) -->
  <div class="md:hidden fixed bottom-0 left-0 w-full bg-white border-t border-gray-200 p-4 z-50 shadow-[0_-4px_20px_rgba(0,0,0,0.05)] flex justify-between items-center">
    <div>
      <p class="text-xs text-gray-500">Mulai dari</p>
      <p class="font-bold text-primary text-lg">{tour.priceDisplay}</p>
    </div>
    <a href={`/booking?tour=${tour.slug}`} class="bg-primary text-white px-6 py-2.5 rounded-full font-medium text-sm">
      Pesan Sekarang
    </a>
  </div>

  <section class="py-12 sm:py-16 bg-bg relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 md:px-8 lg:px-10 xl:px-12">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-10 xl:gap-16">
        
        <!-- Main Info -->
        <div class="lg:col-span-2 space-y-16">
          
          <!-- Highlights -->
          <div>
            <h2 class="font-display text-3xl text-primary mb-6">Highlight Perjalanan</h2>
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
              {tour.highlights.map(h => (
                <div class="bg-white p-4 rounded-xl shadow-sm border border-gray-100 flex items-center justify-center text-center h-24">
                  <span class="font-medium text-gray-800 text-sm leading-snug">{h}</span>
                </div>
              ))}
            </div>
          </div>

          <!-- Overview -->
          <div>
            <h2 class="font-display text-3xl text-primary mb-6">Ringkasan Tour</h2>
            <div class="prose prose-lg prose-gray max-w-none text-gray-700 leading-relaxed">
              <p>{tour.longDescription}</p>
            </div>
          </div>

          <!-- Itinerary -->
          {tour.itinerary.length > 0 && (
            <div>
              <h2 class="font-display text-3xl text-primary mb-8">Itinerary</h2>
              <div class="space-y-8 relative before:absolute before:inset-0 before:ml-5 before:-translate-x-px md:before:mx-auto md:before:translate-x-0 before:h-full before:w-0.5 before:bg-gradient-to-b before:from-transparent before:via-gray-200 before:to-transparent">
                {tour.itinerary.map((day, i) => (
                  <div class="relative flex items-start justify-between md:justify-normal md:odd:flex-row-reverse group is-active">
                    <div class="flex items-center justify-center w-10 h-10 rounded-full border-4 border-bg bg-primary text-white font-bold text-sm shrink-0 md:order-1 md:group-odd:-translate-x-1/2 md:group-even:translate-x-1/2 shadow-sm z-10">
                      {day.day}
                    </div>
                    <div class="w-[calc(100%-3rem)] md:w-[calc(50%-2.5rem)] bg-white p-6 rounded-2xl shadow-sm border border-gray-100 mt-2 md:mt-0">
                      <h4 class="font-bold text-gray-900 mb-2">{day.title}</h4>
                      <p class="text-gray-600 text-sm leading-relaxed">{day.description}</p>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          )}

          <!-- Inclusions / Exclusions -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            <div class="bg-green-50/50 p-6 rounded-2xl border border-green-100">
              <h3 class="font-bold text-green-900 mb-4 flex items-center gap-2">
                <CheckCircle2 className="w-5 h-5 text-green-600" /> Sudah Termasuk
              </h3>
              <ul class="space-y-3">
                {tour.included.map(item => (
                  <li class="flex items-start gap-3 text-sm text-gray-700">
                    <span class="w-1.5 h-1.5 rounded-full bg-green-500 mt-1.5 shrink-0"></span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>
            
            <div class="bg-red-50/50 p-6 rounded-2xl border border-red-100">
              <h3 class="font-bold text-red-900 mb-4 flex items-center gap-2">
                <XCircle className="w-5 h-5 text-red-500" /> Belum Termasuk
              </h3>
              <ul class="space-y-3">
                {tour.excluded.map(item => (
                  <li class="flex items-start gap-3 text-sm text-gray-700">
                    <span class="w-1.5 h-1.5 rounded-full bg-red-400 mt-1.5 shrink-0"></span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>

          <!-- Gallery -->
          {tour.gallery.length > 0 && (
            <div>
              <h2 class="font-display text-3xl text-primary mb-6 flex items-center gap-3">
                <ImageIcon className="w-6 h-6 text-accent" /> Galeri Tour
              </h2>
              <div class="grid grid-cols-2 gap-4">
                {tour.gallery.map(img => (
                  <div class="aspect-[4/3] rounded-2xl overflow-hidden bg-gray-100">
                    <img src={img} alt="" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" loading="lazy" />
                  </div>
                ))}
              </div>
            </div>
          )}
          
        </div>

        <!-- Sticky Sidebar (Desktop only) -->
        <div class="hidden lg:block lg:col-span-1">
          <div class="sticky top-28">
            <div class="bg-white p-8 rounded-3xl shadow-[0_8px_30px_rgb(0,0,0,0.04)] border border-gray-100 mb-6">
              <div class="mb-6 pb-6 border-b border-gray-100">
                <h3 class="font-display text-2xl text-primary mb-2">Ringkasan</h3>
                <p class="text-gray-500 text-sm">{tour.duration} • {tour.destination}</p>
              </div>
              
              <div class="flex items-end justify-between mb-8">
                <div>
                  <p class="text-sm text-gray-500 mb-1">Total harga mulai</p>
                  <p class="text-3xl font-bold text-primary">{tour.priceDisplay}</p>
                </div>
                <p class="text-sm text-gray-500 mb-1">{tour.priceUnit.replace('per', '/')}</p>
              </div>

              <div class="space-y-3">
                <a href={`/booking?tour=${tour.slug}`} class="block w-full bg-primary hover:bg-secondary text-white text-center py-4 rounded-xl font-medium transition-colors shadow-md hover:shadow-lg">
                  Pesan Sekarang
                </a>
                <a href="https://wa.me/6281234567890" target="_blank" class="block w-full bg-white hover:bg-gray-50 border border-gray-200 text-gray-800 text-center py-4 rounded-xl font-medium transition-colors">
                  Chat di WhatsApp
                </a>
              </div>
              
              <p class="text-xs text-center text-gray-400 mt-4 flex items-center justify-center gap-1">
                <CheckCircle2 className="w-3.5 h-3.5" /> Konfirmasi instan via WhatsApp
              </p>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Related Tours -->
  {relatedToursData.length > 0 && (
    <section class="py-16 sm:py-24 bg-white border-t border-gray-100">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 md:px-8 lg:px-10 xl:px-12">
        <div class="flex justify-between items-end mb-10 sm:mb-12">
          <div>
            <h2 class="font-display text-3xl sm:text-4xl text-primary mb-3">Tour Terkait</h2>
            <p class="text-gray-600 text-base sm:text-lg">Mungkin Anda juga menyukai paket ini.</p>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
          {relatedToursData.map(rt => (
            <a href={`/paket-tour/${rt.slug}`} class="group bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-xl transition-shadow border border-gray-100 flex flex-col h-full">
              <div class="relative aspect-[4/3] overflow-hidden">
                <img src={rt.heroImage} alt={rt.name} class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" loading="lazy" />
                <div class="absolute top-4 left-4 bg-white/90 backdrop-blur-sm px-3 py-1 rounded-full text-xs font-semibold text-primary">
                  {rt.duration}
                </div>
              </div>
              <div class="p-6 flex flex-col flex-grow">
                <div class="flex items-center justify-between mb-2">
                  <span class="text-xs font-medium text-gray-500 uppercase tracking-wider">{rt.province}</span>
                </div>
                <h3 class="font-display text-2xl text-primary mb-2 line-clamp-1 group-hover:text-accent transition-colors">{rt.name}</h3>
                <p class="text-gray-600 text-sm mb-6 line-clamp-2 flex-grow">{rt.shortDescription}</p>
                <div class="border-t border-gray-100 pt-4 mt-auto">
                  <p class="text-sm text-gray-500 mb-1">Mulai dari</p>
                  <p class="text-lg font-bold text-primary">{rt.priceDisplay}<span class="text-sm font-normal text-gray-500"> /org</span></p>
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
</Layout>
