---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Halaman Tidak Ditemukan — FindPath" description="Halaman yang Anda cari tidak tersedia. Jelajahi paket tour dan destinasi Kalimantan bersama FindPath.">
  <section class="min-h-[70svh] bg-bg px-5 pt-32 pb-20 flex items-center">
    <div class="max-w-3xl mx-auto text-center">
      <p class="text-sm font-semibold tracking-[0.2em] uppercase text-accent mb-5">404 · Halaman tidak ditemukan</p>
      <h1 class="font-display text-5xl md:text-7xl leading-tight text-primary mb-6">Sepertinya jalur ini buntu.</h1>
      <p class="text-gray-600 text-lg leading-relaxed max-w-xl mx-auto mb-9">Alamatnya mungkin sudah berubah atau tidak tersedia. Mulai lagi dari beranda atau lanjut jelajahi perjalanan di Kalimantan.</p>
      <div class="flex flex-wrap justify-center gap-3">
        <a href="/" class="inline-flex items-center rounded-full bg-primary px-6 py-3 text-white font-semibold hover:bg-secondary transition-colors">Kembali ke Beranda</a>
        <a href="/paket-tour" class="inline-flex items-center rounded-full border border-primary/20 px-6 py-3 text-primary font-semibold hover:bg-primary/5 transition-colors">Lihat Paket Tour</a>
      </div>
    </div>
  </section>
</Layout>
